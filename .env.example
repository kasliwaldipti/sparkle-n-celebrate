# Copy to .env for local development. In production, set these in cPanel > Setup Node.js App.
# Never commit real values. Only NEXT_PUBLIC_* vars reach the browser.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Neon Postgres) ---
# Pooled connection string (host contains "-pooler"), used by the app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection string, used by migrations and the seed script.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Required when running behind a proxy such as cPanel/Passenger.
AUTH_TRUST_HOST=true
# AUTH_URL=https://your-domain.in

# --- Seed users (only used by npm run db:seed) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=

# --- Cloudinary (product images) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (payments, INR) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Resend (email) ---
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. orders@your-domain.in
EMAIL_FROM=

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- AfterShip (courier tracking webhooks) ---
AFTERSHIP_API_KEY=
AFTERSHIP_WEBHOOK_SECRET=

# --- Inngest (background jobs) ---
# Local dev: run `npx inngest-cli@latest dev` and set INNGEST_DEV=1 (keys not needed).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_DEV=1

# --- Anthropic (order-update agent) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
